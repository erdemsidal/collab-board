# ═══════════════════════════════════════════════════════
# CollabBoard — ortam değişkenleri
#
#   cp .env.example .env
#
# Bu dosya uygulama tarafından OKUNUR (spring-dotenv). Yorum satırı olarak
# bırakılan her ayar için application.yml'deki varsayılan geçerli olur;
# yerel geliştirmede o varsayılanlar docker-compose ile birebir uyuşur.
#
# Yani doldurman gereken tek bölüm E-POSTA. Gerisi yalnızca üretim içindir.
# ═══════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════
# E-POSTA (SMTP) — ZORUNLU
#
# Kayıt olan kullanıcılara doğrulama bağlantısı buradan gider. Ayarlanmazsa
# yeni kayıtlar giriş YAPAMAZ. Adım adım kurulum: docs/MAIL-KURULUMU.md
#
# Gmail için: normal hesap şifresi ÇALIŞMAZ. 2 adımlı doğrulamayı açıp
# https://myaccount.google.com/apppasswords adresinden 16 haneli bir
# "Uygulama Şifresi" üret ve buraya BOŞLUKSUZ yapıştır.
# ═══════════════════════════════════════════════════════
MAIL_USERNAME=senin.adresin@gmail.com
MAIL_PASSWORD=abcdefghijklmnop

# Gönderen adı. Gmail, adresin kimlik doğrulanan hesapla eşleşmesini ister;
# eşleşmezse kendi adresiyle değiştirir.
MAIL_FROM=CollabBoard <senin.adresin@gmail.com>

# Sunucu ayarları — Gmail için varsayılanlar zaten doğru.
# Başka sağlayıcı kullanıyorsan docs/MAIL-KURULUMU.md sonundaki tabloya bak.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# 465 portu kullanan sunucularda: STARTTLS=false ve SSL=true
# MAIL_SMTP_SSL=false

# Doğrulama bağlantısının ömrü (saat)
# MAIL_VERIFICATION_HOURS=24


# ═══════════════════════════════════════════════════════
# UYGULAMA ADRESİ
#
# Doğrulama postasındaki bağlantı buradan üretilir. Yerelde varsayılan
# (http://localhost:8080) doğrudur. CANLIYA ÇIKARKEN MUTLAKA DEĞİŞTİR,
# yoksa postadaki bağlantı kullanıcının kendi makinesini gösterir.
# ═══════════════════════════════════════════════════════
# APP_BASE_URL=https://collab-board.up.railway.app


# ═══════════════════════════════════════════════════════
# ÜRETİM AYARLARI
#
# Aşağıdakiler YERELDE GEREKMEZ — açık bırakılırsa varsayılanlar kullanılır
# ve docker-compose ile uyuşur. Canlıya çıkarken hepsi verilmelidir.
# ═══════════════════════════════════════════════════════

# ── JWT ────────────────────────────────────────────────
# ⚠️ application.yml'deki varsayılan anahtar GitHub'da herkese açıktır.
# Üretimde MUTLAKA kendi anahtarını üret (en az 64 karakter, geçerli Base64):
#   openssl rand -base64 64
# Base64 OLMAYAN bir değer verirsen uygulama açılmaz.
# JWT_SECRET=

# ── İzin verilen kaynaklar (origin) ─────────────────────
# WebSocket el sıkışmasında hangi sayfaların bağlanabileceği; virgülle ayrılır.
# Yerelde varsayılan yeterlidir. Canlıda kendi adresini yaz — joker (*) kabul
# edilmez, herhangi bir sitenin arka planda bağlanmasına izin verirdi.
# CORS_ALLOWED_ORIGINS=https://collab-board.up.railway.app

# ── PostgreSQL ─────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=collabboard
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ── Redis ──────────────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── Sentry (hata izleme) — https://sentry.io ────────────
# SENTRY_DSN=

# ── Spring profili (dev | prod) ─────────────────────────
# SPRING_PROFILES_ACTIVE=dev
