# Posta modu: mailpit (yerel geliştirmede VARSAYILAN)
#
# docker-compose.yml bu dosyayı .env'den SONRA okur; buradaki değerler
# .env'deki posta ayarlarının (Gmail, Brevo) üstüne yazar. Sonuç: uygulamanın
# yolladığı her posta Mailpit'te yakalanır, hiçbiri gerçek bir kutuya gitmez.
# Postaları görmek için:  .\scripts\dev.ps1 mail
#
# Gerçek posta göndermek için bu dosyayı DEĞİŞTİRME; modu değiştir:
#   .\scripts\dev.ps1 up -RealMail      ya da .env'e:  STURNIO_MAIL=gercek
#
# Sır yok, bu yüzden depoda duruyor. Mailpit kimlik sormaz; kullanıcı adı
# yalnızca açılıştaki posta denetimi "ayar eksik" uyarısı vermesin diye var.

MAIL_PROVIDER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=dev@sturnio.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
MAIL_FROM="Sturnio <dev@sturnio.local>"
BREVO_API_KEY=
